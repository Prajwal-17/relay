{
  "name": "@relay/server",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "build": "wrangler deploy --dry-run --outdir dist",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.test.json",
    "check-types": "tsc --noEmit",
    "cf-typegen": "wrangler types",
    "db:generate": "drizzle-kit generate",
    "db:migrate:local": "wrangler d1 migrations apply relay-server-db --local",
    "db:migrate:remote": "wrangler d1 migrations apply relay-server-db --remote",
    "test": "node --import ../../scripts/register-tests.ts --test tests/*.test.ts"
  },
  "dependencies": {
    "@relay/shared": "workspace:*",
    "@better-auth/expo": "^1.7.0",
    "better-auth": "^1.7.0",
    "drizzle-orm": "^0.45.2",
    "hono": "^4.12.27",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "drizzle-kit": "^0.31.8",
    "prettier": "^3.7.4",
    "typescript": "~6.0.3",
    "wrangler": "^4.141.0"
  }
}
