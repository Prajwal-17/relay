{
  "name": "@relay/server",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "build": "wrangler deploy --dry-run --outdir dist",
    "typecheck": "tsc --noEmit",
    "check-types": "tsc --noEmit",
    "cf-typegen": "wrangler types",
    "db:generate": "drizzle-kit generate",
    "db:migrate:local": "wrangler d1 migrations apply relay-server-db --local",
    "db:migrate:remote": "wrangler d1 migrations apply relay-server-db --remote"
  },
  "dependencies": {
    "@better-auth/expo": "^1.7.0",
    "better-auth": "^1.7.0",
    "drizzle-orm": "^0.45.2",
    "hono": "^4.12.27",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "drizzle-kit": "^0.31.8",
    "typescript": "~6.0.3",
    "wrangler": "^4.43.0"
  }
}
